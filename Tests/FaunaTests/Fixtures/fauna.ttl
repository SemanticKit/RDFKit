@prefix : <https://fauna.example.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

:Animal a rdfs:Class ;
    rdfs:label "Animal" ;
    rdfs:comment "The class of all animals." .

:Predator a rdfs:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Predator" ;
    rdfs:comment "An animal that hunts other animals." .

:Prey a rdfs:Class ;
    rdfs:subClassOf :Animal ;
    rdfs:label "Prey" ;
    rdfs:comment "An animal that other animals hunt." .

:Mesopredator a rdfs:Class ;
    rdfs:subClassOf :Predator, :Prey ;
    rdfs:label "Mesopredator" ;
    rdfs:comment "A predator that is itself hunted by larger predators." .

:Habitat a rdfs:Class ;
    rdfs:label "Habitat" ;
    rdfs:comment "The class of natural habitats." .

:Diet a rdfs:Class ;
    rdfs:label "Diet" ;
    rdfs:comment "The class of dietary classifications." .

:carnivore a :Diet ;
    rdfs:label "carnivore" ;
    rdfs:comment "A diet of other animals." .

:herbivore a :Diet ;
    rdfs:label "herbivore" ;
    rdfs:comment "A diet of plants." .

:omnivore a :Diet ;
    rdfs:label "omnivore" ;
    rdfs:comment "A diet of plants and animals." .

:hasHabitat a owl:ObjectProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Habitat ;
    rdfs:label "has habitat" ;
    rdfs:comment "A natural habitat of an animal." .

:inhabitedBy a owl:ObjectProperty ;
    rdfs:domain :Habitat ;
    rdfs:range :Animal ;
    rdfs:label "inhabited by" ;
    rdfs:comment "An animal that lives in a habitat." .

:hasDiet a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:domain :Animal ;
    rdfs:range :Diet ;
    rdfs:label "has diet" ;
    rdfs:comment "The dietary classification of an animal." .

:preysOn a owl:ObjectProperty ;
    rdfs:domain :Predator ;
    rdfs:range :Animal ;
    rdfs:label "preys on" ;
    rdfs:comment """An animal this predator hunts for food.
Its range is "Animal", so a predator can prey on another predator.""" .

:commonName a owl:DatatypeProperty ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal ;
    rdfs:label "common name" ;
    rdfs:comment "A common name of an animal." .

:scientificName a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Animal ;
    rdfs:range rdfs:Literal ;
    rdfs:label "scientific name" ;
    rdfs:comment "The binomial nomenclature of an animal." .

:averageLifespan a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Animal ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "average lifespan" ;
    rdfs:comment "The average lifespan of an animal, in years." .
