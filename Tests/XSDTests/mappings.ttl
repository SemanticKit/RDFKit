# Literals of the XSD datatypes, decoded at the boundary into the Swift
# value types of the XSD module, for the XSD tests. Each literal is a value
# of the samples property (samples.ttl) that ranges over its datatype.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix samples: <https://xsd.example/samples#> .
@prefix : <https://xsd.example/mappings#> .

:Mapping a owl:Class ;
    rdfs:subClassOf samples:Sample ;
    rdfs:comment "A literal of an XSD datatype, as the value of the samples property that ranges over the datatype, and the canonical representation of its value (XML Schema 1.1 Part 2, the canonical mapping)." .
:canonical a rdf:Property ;
    rdfs:domain :Mapping .

:Equal a owl:Class ;
    rdfs:subClassOf samples:Sample ;
    rdfs:comment "Two literals of an XSD datatype whose values are equal, as values of the samples property that ranges over the datatype." .

:IllTyped a owl:Class ;
    rdfs:subClassOf samples:Sample ;
    rdfs:comment "A literal of an XSD datatype whose lexical form is not in the datatype's lexical space (RDF 1.2 Concepts §3.4), as a value of the samples property that ranges over the datatype." .

# Lexical forms and the canonical forms of their values.

:string-whitespace a :Mapping ;
    samples:string " a\tb "^^xsd:string ;
    :canonical " a\tb " .

:boolean-one a :Mapping ;
    samples:boolean "1"^^xsd:boolean ;
    :canonical "true" .

:boolean-zero a :Mapping ;
    samples:boolean "0"^^xsd:boolean ;
    :canonical "false" .

:decimal-signs-and-zeros a :Mapping ;
    samples:decimal "+01.50"^^xsd:decimal ;
    :canonical "1.5" .

:decimal-negative-zero a :Mapping ;
    samples:decimal "-.0"^^xsd:decimal ;
    :canonical "0" .

:decimal-integral a :Mapping ;
    samples:decimal "10.0"^^xsd:decimal ;
    :canonical "10" .

:integer-leading-zeros a :Mapping ;
    samples:integer "+007"^^xsd:integer ;
    :canonical "7" .

:integer-negative-zero a :Mapping ;
    samples:integer "-0"^^xsd:integer ;
    :canonical "0" .

:double-exponent a :Mapping ;
    samples:double "1e2"^^xsd:double ;
    :canonical "1.0E2" .

:double-negative-zero a :Mapping ;
    samples:double "-0"^^xsd:double ;
    :canonical "-0.0E0" .

:double-infinity a :Mapping ;
    samples:double "+INF"^^xsd:double ;
    :canonical "INF" .

:double-tenth a :Mapping ;
    samples:double "0.1"^^xsd:double ;
    :canonical "1.0E-1" .

:double-largest a :Mapping ;
    samples:double "1.7976931348623157e308"^^xsd:double ;
    :canonical "1.7976931348623157E308" .

:double-not-a-number a :Mapping ;
    samples:double "NaN"^^xsd:double ;
    :canonical "NaN" .

:float-rounded a :Mapping ;
    samples:float "16777217"^^xsd:float ;
    :canonical "1.6777216E7" .

:float-smallest a :Mapping ;
    samples:float "1e-45"^^xsd:float ;
    :canonical "1.0E-45" .

:date-utc a :Mapping ;
    samples:date "2010-05-03+00:00"^^xsd:date ;
    :canonical "2010-05-03Z" .

:time-end-of-day a :Mapping ;
    samples:time "24:00:00"^^xsd:time ;
    :canonical "00:00:00" .

:time-fraction a :Mapping ;
    samples:time "13:20:00.500"^^xsd:time ;
    :canonical "13:20:00.5" .

:dateTime-end-of-day a :Mapping ;
    samples:dateTime "2026-10-30T24:00:00.000-05:00"^^xsd:dateTime ;
    :canonical "2026-10-31T00:00:00-05:00" .

:dateTime-leap-day a :Mapping ;
    samples:dateTime "2024-02-29T23:59:59.9"^^xsd:dateTime ;
    :canonical "2024-02-29T23:59:59.9" .

:dateTime-year-zero a :Mapping ;
    samples:dateTime "0000-01-01T00:00:00Z"^^xsd:dateTime ;
    :canonical "0000-01-01T00:00:00Z" .

:dateTime-five-digit-year a :Mapping ;
    samples:dateTime "12026-01-01T00:00:00"^^xsd:dateTime ;
    :canonical "12026-01-01T00:00:00" .

:dateTimeStamp-utc a :Mapping ;
    samples:dateTimeStamp "2026-10-30T12:00:00.0+00:00"^^xsd:dateTimeStamp ;
    :canonical "2026-10-30T12:00:00Z" .

:gYear-negative a :Mapping ;
    samples:gYear "-0044"^^xsd:gYear ;
    :canonical "-0044" .

:gYear-utc a :Mapping ;
    samples:gYear "2026+00:00"^^xsd:gYear ;
    :canonical "2026Z" .

:gMonth-utc a :Mapping ;
    samples:gMonth "--02-00:00"^^xsd:gMonth ;
    :canonical "--02Z" .

:gDay-utc a :Mapping ;
    samples:gDay "---31+00:00"^^xsd:gDay ;
    :canonical "---31Z" .

:gYearMonth-utc a :Mapping ;
    samples:gYearMonth "2026-10+00:00"^^xsd:gYearMonth ;
    :canonical "2026-10Z" .

:gMonthDay-leap-day a :Mapping ;
    samples:gMonthDay "--02-29"^^xsd:gMonthDay ;
    :canonical "--02-29" .

:duration-months a :Mapping ;
    samples:duration "P12M"^^xsd:duration ;
    :canonical "P1Y" .

:duration-hours a :Mapping ;
    samples:duration "PT36H"^^xsd:duration ;
    :canonical "P1DT12H" .

:duration-zero a :Mapping ;
    samples:duration "P0D"^^xsd:duration ;
    :canonical "PT0S" .

:duration-negative-minutes a :Mapping ;
    samples:duration "-PT90M"^^xsd:duration ;
    :canonical "-PT1H30M" .

:yearMonthDuration-zero a :Mapping ;
    samples:yearMonthDuration "P0Y"^^xsd:yearMonthDuration ;
    :canonical "P0M" .

:yearMonthDuration-months a :Mapping ;
    samples:yearMonthDuration "P18M"^^xsd:yearMonthDuration ;
    :canonical "P1Y6M" .

:dayTimeDuration-hours a :Mapping ;
    samples:dayTimeDuration "PT24H"^^xsd:dayTimeDuration ;
    :canonical "P1D" .

:dayTimeDuration-fraction a :Mapping ;
    samples:dayTimeDuration "PT0.50S"^^xsd:dayTimeDuration ;
    :canonical "PT0.5S" .

:byte-largest a :Mapping ;
    samples:byte "+0127"^^xsd:byte ;
    :canonical "127" .

:short-smallest a :Mapping ;
    samples:short "-032768"^^xsd:short ;
    :canonical "-32768" .

:int-largest a :Mapping ;
    samples:int "+2147483647"^^xsd:int ;
    :canonical "2147483647" .

:long-smallest a :Mapping ;
    samples:long "-09223372036854775808"^^xsd:long ;
    :canonical "-9223372036854775808" .

:unsignedByte-largest a :Mapping ;
    samples:unsignedByte "0255"^^xsd:unsignedByte ;
    :canonical "255" .

:unsignedShort-largest a :Mapping ;
    samples:unsignedShort "065535"^^xsd:unsignedShort ;
    :canonical "65535" .

:unsignedInt-largest a :Mapping ;
    samples:unsignedInt "+4294967295"^^xsd:unsignedInt ;
    :canonical "4294967295" .

:unsignedLong-largest a :Mapping ;
    samples:unsignedLong "018446744073709551615"^^xsd:unsignedLong ;
    :canonical "18446744073709551615" .

:positiveInteger-one a :Mapping ;
    samples:positiveInteger "+1"^^xsd:positiveInteger ;
    :canonical "1" .

:nonNegativeInteger-zero a :Mapping ;
    samples:nonNegativeInteger "-0"^^xsd:nonNegativeInteger ;
    :canonical "0" .

:negativeInteger-one a :Mapping ;
    samples:negativeInteger "-01"^^xsd:negativeInteger ;
    :canonical "-1" .

:nonPositiveInteger-zero a :Mapping ;
    samples:nonPositiveInteger "+0"^^xsd:nonPositiveInteger ;
    :canonical "0" .

:hexBinary-lower-case a :Mapping ;
    samples:hexBinary "0fb7"^^xsd:hexBinary ;
    :canonical "0FB7" .

:base64Binary-spaces a :Mapping ;
    samples:base64Binary "SG Vs bG8="^^xsd:base64Binary ;
    :canonical "SGVsbG8=" .

:anyURI-reference a :Mapping ;
    samples:anyURI "../people/ren\u00E9e#summary"^^xsd:anyURI ;
    :canonical "../people/ren\u00E9e#summary" .

:language-region a :Mapping ;
    samples:language "en-GB"^^xsd:language ;
    :canonical "en-GB" .

:normalizedString-spaces a :Mapping ;
    samples:normalizedString "a  b"^^xsd:normalizedString ;
    :canonical "a  b" .

:token-words a :Mapping ;
    samples:token "a b"^^xsd:token ;
    :canonical "a b" .

:NMTOKEN-hyphen a :Mapping ;
    samples:NMTOKEN "-x"^^xsd:NMTOKEN ;
    :canonical "-x" .

:Name-colon a :Mapping ;
    samples:Name ":x"^^xsd:Name ;
    :canonical ":x" .

:NCName-dots a :Mapping ;
    samples:NCName "x.y"^^xsd:NCName ;
    :canonical "x.y" .

# Different lexical forms of one value.

:dateTime-zones a :Equal ;
    samples:dateTime "2026-10-30T12:00:00Z"^^xsd:dateTime, "2026-10-30T13:00:00+01:00"^^xsd:dateTime .

:duration-year a :Equal ;
    samples:duration "P1Y"^^xsd:duration, "P12M"^^xsd:duration .

:decimal-trailing-zero a :Equal ;
    samples:decimal "1.50"^^xsd:decimal, "1.5"^^xsd:decimal .

:double-forms a :Equal ;
    samples:double "1e0"^^xsd:double, "1"^^xsd:double .

:time-midnight a :Equal ;
    samples:time "00:00:00"^^xsd:time, "24:00:00"^^xsd:time .

:gYear-zones a :Equal ;
    samples:gYear "2026Z"^^xsd:gYear, "2026+00:00"^^xsd:gYear .

# Ill-typed literals.

:integer-fraction a :IllTyped ;
    samples:integer "1.0"^^xsd:integer .

:integer-empty a :IllTyped ;
    samples:integer ""^^xsd:integer .

:integer-space a :IllTyped ;
    samples:integer " 1"^^xsd:integer .

:boolean-capitals a :IllTyped ;
    samples:boolean "TRUE"^^xsd:boolean .

:decimal-exponent a :IllTyped ;
    samples:decimal "1e2"^^xsd:decimal .

:double-lower-case-infinity a :IllTyped ;
    samples:double "inf"^^xsd:double .

:double-hexadecimal a :IllTyped ;
    samples:double "0x1p3"^^xsd:double .

:float-two-points a :IllTyped ;
    samples:float "1.0.0"^^xsd:float .

:date-not-a-leap-year a :IllTyped ;
    samples:date "2023-02-29"^^xsd:date .

:dateTime-offset-too-wide a :IllTyped ;
    samples:dateTime "2026-10-30T12:00:00+14:30"^^xsd:dateTime .

:dateTimeStamp-no-timezone a :IllTyped ;
    samples:dateTimeStamp "2026-10-30T12:00:00"^^xsd:dateTimeStamp .

:time-hour a :IllTyped ;
    samples:time "25:00:00"^^xsd:time .

:gYear-two-digits a :IllTyped ;
    samples:gYear "26"^^xsd:gYear .

:gMonth-thirteen a :IllTyped ;
    samples:gMonth "--13"^^xsd:gMonth .

:gDay-thirty-two a :IllTyped ;
    samples:gDay "---32"^^xsd:gDay .

:gYearMonth-thirteen a :IllTyped ;
    samples:gYearMonth "2026-13"^^xsd:gYearMonth .

:gMonthDay-february-thirtieth a :IllTyped ;
    samples:gMonthDay "--02-30"^^xsd:gMonthDay .

:duration-empty-time a :IllTyped ;
    samples:duration "P1DT"^^xsd:duration .

:duration-nothing a :IllTyped ;
    samples:duration "PT"^^xsd:duration .

:yearMonthDuration-days a :IllTyped ;
    samples:yearMonthDuration "P1D"^^xsd:yearMonthDuration .

:dayTimeDuration-months a :IllTyped ;
    samples:dayTimeDuration "P1M"^^xsd:dayTimeDuration .

:byte-too-large a :IllTyped ;
    samples:byte "128"^^xsd:byte .

:short-too-small a :IllTyped ;
    samples:short "-32769"^^xsd:short .

:int-too-large a :IllTyped ;
    samples:int "2147483648"^^xsd:int .

:long-too-large a :IllTyped ;
    samples:long "9223372036854775808"^^xsd:long .

:unsignedByte-negative a :IllTyped ;
    samples:unsignedByte "-1"^^xsd:unsignedByte .

:unsignedShort-too-large a :IllTyped ;
    samples:unsignedShort "65536"^^xsd:unsignedShort .

:unsignedInt-too-large a :IllTyped ;
    samples:unsignedInt "4294967296"^^xsd:unsignedInt .

:unsignedLong-too-large a :IllTyped ;
    samples:unsignedLong "18446744073709551616"^^xsd:unsignedLong .

:positiveInteger-zero a :IllTyped ;
    samples:positiveInteger "0"^^xsd:positiveInteger .

:nonNegativeInteger-negative a :IllTyped ;
    samples:nonNegativeInteger "-1"^^xsd:nonNegativeInteger .

:negativeInteger-zero a :IllTyped ;
    samples:negativeInteger "0"^^xsd:negativeInteger .

:nonPositiveInteger-one a :IllTyped ;
    samples:nonPositiveInteger "1"^^xsd:nonPositiveInteger .

:hexBinary-odd a :IllTyped ;
    samples:hexBinary "abc"^^xsd:hexBinary .

:base64Binary-unused-bits a :IllTyped ;
    samples:base64Binary "SGVsbG9="^^xsd:base64Binary .

:language-underscore a :IllTyped ;
    samples:language "en_US"^^xsd:language .

:token-leading-space a :IllTyped ;
    samples:token " a"^^xsd:token .

:normalizedString-tab a :IllTyped ;
    samples:normalizedString "a\tb"^^xsd:normalizedString .

:NMTOKEN-space a :IllTyped ;
    samples:NMTOKEN "a b"^^xsd:NMTOKEN .

:Name-hyphen-first a :IllTyped ;
    samples:Name "-x"^^xsd:Name .

:NCName-colon a :IllTyped ;
    samples:NCName "a:b"^^xsd:NCName .

:string-control a :IllTyped ;
    samples:string "a\u0001"^^xsd:string .

:anyURI-control a :IllTyped ;
    samples:anyURI "\u0001"^^xsd:anyURI .

# A value of each datatype, in its canonical form, as a value of the
# samples property that ranges over the datatype.
:typical a samples:Sample ;
    samples:string "Almanac"^^xsd:string ;
    samples:boolean "true"^^xsd:boolean ;
    samples:decimal "-1.5"^^xsd:decimal ;
    samples:integer "12345678901234567890"^^xsd:integer ;
    samples:double "1.25E-3"^^xsd:double ;
    samples:float "3.0E0"^^xsd:float ;
    samples:date "2026-10-30"^^xsd:date ;
    samples:time "13:20:00Z"^^xsd:time ;
    samples:dateTime "2026-10-30T13:20:00.25+01:00"^^xsd:dateTime ;
    samples:dateTimeStamp "2026-10-30T12:20:00.25Z"^^xsd:dateTimeStamp ;
    samples:gYear "2026"^^xsd:gYear ;
    samples:gMonth "--10"^^xsd:gMonth ;
    samples:gDay "---30"^^xsd:gDay ;
    samples:gYearMonth "2026-10"^^xsd:gYearMonth ;
    samples:gMonthDay "--10-30"^^xsd:gMonthDay ;
    samples:duration "-P1Y2M3DT4H5M6.7S"^^xsd:duration ;
    samples:yearMonthDuration "P1Y2M"^^xsd:yearMonthDuration ;
    samples:dayTimeDuration "P3DT4H5M6.7S"^^xsd:dayTimeDuration ;
    samples:byte "-128"^^xsd:byte ;
    samples:short "32767"^^xsd:short ;
    samples:int "-2147483648"^^xsd:int ;
    samples:long "9223372036854775807"^^xsd:long ;
    samples:unsignedByte "255"^^xsd:unsignedByte ;
    samples:unsignedShort "0"^^xsd:unsignedShort ;
    samples:unsignedInt "42"^^xsd:unsignedInt ;
    samples:unsignedLong "18446744073709551615"^^xsd:unsignedLong ;
    samples:positiveInteger "1"^^xsd:positiveInteger ;
    samples:nonNegativeInteger "0"^^xsd:nonNegativeInteger ;
    samples:negativeInteger "-1"^^xsd:negativeInteger ;
    samples:nonPositiveInteger "0"^^xsd:nonPositiveInteger ;
    samples:hexBinary "0FB7"^^xsd:hexBinary ;
    samples:base64Binary "SGVsbG8="^^xsd:base64Binary ;
    samples:anyURI "https://example.org/people/ren\u00E9e"^^xsd:anyURI ;
    samples:language "zh-Hant-TW"^^xsd:language ;
    samples:normalizedString "Almanac,  second edition"^^xsd:normalizedString ;
    samples:token "Almanac second edition"^^xsd:token ;
    samples:NMTOKEN "second-edition"^^xsd:NMTOKEN ;
    samples:Name "edition:second"^^xsd:Name ;
    samples:NCName "second-edition"^^xsd:NCName .

# Literals of other datatypes and forms. A literal of any datatype derived
# from the range's primitive that is well-typed in its own datatype and
# whose value is in the range's value space is a value of the range, and
# writes back as it is: not canonical ("07", "1"), of a datatype the range is
# derived from (3, an xsd:integer), derived from the range ("4"^^xsd:unsignedByte),
# or of another datatype derived from the same primitive
# ("5"^^xsd:unsignedByte for xsd:byte). The others stay literals: ill-typed
# ("-1", "yes"), outside the range ("-2"^^xsd:integer), of another primitive
# ("1.5"^^xsd:double for xsd:decimal), language-tagged, and of a datatype
# with no Swift type.
:unusual a samples:Sample ;
    samples:nonNegativeInteger "5"^^xsd:nonNegativeInteger, "-1"^^xsd:nonNegativeInteger, "07"^^xsd:nonNegativeInteger, 3, "4"^^xsd:unsignedByte, "-2"^^xsd:integer ;
    samples:boolean "yes"^^xsd:boolean, "1"^^xsd:boolean ;
    samples:byte "5"^^xsd:unsignedByte ;
    samples:decimal "1.5"^^xsd:double ;
    samples:string "x"^^<https://xsd.example/datatypes#unknown>, "y"@en .
