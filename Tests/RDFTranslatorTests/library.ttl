# A small library vocabulary and its data, for the translator's tests.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://library.example/vocabulary#> .

:Work a owl:Class ;
    rdfs:label "Work"@en, "Werk"@de ;
    rdfs:comment "Something written." .

:Book a owl:Class ;
    rdfs:subClassOf :Work .

:Periodical a owl:Class ;
    rdfs:subClassOf :Work .

:Annual a owl:Class ;
    rdfs:comment "A book that is also a periodical: it comes out once a year." ;
    rdfs:subClassOf :Book, :Periodical .

:cites a owl:ObjectProperty ;
    rdfs:domain :Work ;
    rdfs:range :Work .

:title a owl:DatatypeProperty ;
    rdfs:domain :Work ;
    rdfs:range xsd:string .

:pages a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:shelfmark a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:comment "Replaced by the catalogue number." .

:editors a owl:ObjectProperty ;
    rdfs:domain :Work ;
    rdfs:range rdf:List .

:almanac a :Annual ;
    :title "Almanac"@en, "Almanach"@de ;
    :pages "212"^^xsd:nonNegativeInteger ;
    :cites :gazette ;
    :editors ( :ann :ben ) .

:gazette a :Periodical ;
    :title "Gazette" ;
    :cites :almanac ;
    rdfs:comment [ rdf:value "A note found in the first issue." ; rdfs:label "note" ] .

:second-edition a :Book ;
    :title "Almanac, second edition" ;
    :cites :almanac, :second-edition .

:ann rdfs:label "Ann" .
:ben rdfs:label "Ben" .
