# A small library vocabulary and its data, for the translator's tests.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <https://library.example/vocabulary#> .

:Work a owl:Class ;
    rdfs:label "Work"@en, "Werk"@de ;
    rdfs:comment "Something written." .

:Book a owl:Class ;
    rdfs:subClassOf :Work .

:Periodical a owl:Class ;
    rdfs:subClassOf :Work .

:Annual a owl:Class ;
    rdfs:comment "A book that is also a periodical: it comes out once a year." ;
    rdfs:subClassOf :Book, :Periodical .

:cites a owl:ObjectProperty ;
    rdfs:domain :Work ;
    rdfs:range :Work .

:title a owl:DatatypeProperty ;
    rdfs:domain :Work ;
    rdfs:range xsd:string .

:pages a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:nonNegativeInteger .

:edition a owl:DatatypeProperty ;
    rdfs:domain :Book ;
    rdfs:range xsd:positiveInteger .

:published a owl:DatatypeProperty ;
    rdfs:domain :Work ;
    rdfs:range xsd:gYear .

:CatalogueNumber a rdfs:Datatype ;
    rdfs:comment "The library's own datatype, which has no Swift type." .

:catalogueNumber a owl:DatatypeProperty ;
    rdfs:domain :Work ;
    rdfs:range :CatalogueNumber .

:shelfmark a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:comment "Replaced by the catalogue number." .

:editors a owl:ObjectProperty ;
    rdfs:domain :Work ;
    rdfs:range rdf:List .

:almanac a :Annual ;
    :title "Almanac"@en, "Almanach"@de ;
    :pages "212"^^xsd:nonNegativeInteger ;
    :published "1923"^^xsd:gYear ;
    :catalogueNumber "A-1923"^^:CatalogueNumber ;
    :cites :gazette ;
    :editors ( :ann :ben ) .

:gazette a :Periodical ;
    :title "Gazette" ;
    :cites :almanac ;
    rdfs:seeAlso [ rdf:value "A note found in the first issue." ; rdfs:label "note" ] .

:second-edition a :Book ;
    :title "Almanac, second edition" ;
    # Not the canonical form of 2, which is "2".
    :edition "02"^^xsd:positiveInteger ;
    :cites :almanac, :second-edition .

:ann rdfs:label "Ann" .
:ben rdfs:label "Ben" .

# Ill-typed: not in the lexical space of xsd:positiveInteger.
:third-edition a :Book ;
    :edition "third"^^xsd:positiveInteger .

# owl:cardinality ranges over xsd:nonNegativeInteger in owl.ttl; 1 is an
# xsd:integer literal. A restriction is a class, whose description keeps
# every literal as it is.
:pages-restriction a owl:Restriction ;
    owl:onProperty :pages ;
    owl:cardinality 1 ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger .
